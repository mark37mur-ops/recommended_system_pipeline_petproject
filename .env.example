# Copy to .env (git-ignored) and replace every "change-me" with a random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Postgres creates the roles from these on the first start of an empty volume.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
# Stage 4 (Airflow): set before the first start, or re-run the init script afterwards.
AIRFLOW_DB_PASSWORD=

# API
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me
COOKIE_SECURE=false
API_PORT=8000

# Host ports of internal services (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
REDIS_PORT=6379
MLFLOW_PORT=5000
