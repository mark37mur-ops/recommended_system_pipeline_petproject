# Copy to .env (git-ignored) and replace every "change-me" with a random value, one per line:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# token_urlsafe output is URL-safe, so it also works inside the database URLs.
# The API refuses to start while ADMIN_TOKEN or SESSION_SECRET is a placeholder ("change...")
# or shorter than 32 characters; an empty ADMIN_TOKEN outside compose disables the admin API.
# Postgres creates the roles from these on the first start of an empty volume; the db-init
# job re-applies them (and adds missing databases) on every `docker compose up`.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
MLFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me

# API
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me
COOKIE_SECURE=false
# Published on 127.0.0.1 only; other machines go through Caddy (stage 6).
API_PORT=8000
# Proxies trusted for X-Forwarded-For (stage 6: Caddy's address).
# FORWARDED_ALLOW_IPS=127.0.0.1

# Airflow (UI on 127.0.0.1:AIRFLOW_PORT, user AIRFLOW_ADMIN_USER / AIRFLOW_ADMIN_PASSWORD)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Encrypts connection passwords in Airflow's DB; must be a Fernet key, generate with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change-me
# Signing keys shared by all Airflow components (token_urlsafe as above).
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
AIRFLOW_PORT=8080

# Host ports of internal services (bound to 127.0.0.1 only)
POSTGRES_PORT=5432
REDIS_PORT=6379
MLFLOW_PORT=5000
